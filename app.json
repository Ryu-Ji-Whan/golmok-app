{
  "expo": {
    "name": "골목대장",
    "slug": "golmok-daejang",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "golmok",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.golmokdaejang.app"
    },
    "android": {
      "package": "com.golmokdaejang.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "걸은 골목을 지도에 칠하고, 스티커 기록 위치를 정하려고 위치를 사용해요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "기록에 붙일 사진을 고르려고 사진첩을 사용해요.",
          "cameraPermission": "기록에 붙일 사진을 찍으려고 카메라를 사용해요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
